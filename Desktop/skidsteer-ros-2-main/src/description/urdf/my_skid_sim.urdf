<!-- robot.urdf - Fixed version for semantic mapping
     2D LaserScan (/scan) cho SLAM
     3D PointCloud2 (/velodyne_points) cho Semantic Mapping
     RGB Camera (/camera/image_raw)
     Depth Camera (/camera/depth/image_raw)
-->
<robot name="simulation">

  <link name="basefoot_link"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0.02708 -0.023695 0.065325" rpy="0 0 0"/>
      <mass value="15"/>
      <inertia ixx="0.17851" ixy="6.8935E-06" ixz="9.9958E-05"
               iyy="0.17654" iyz="-6.5848E-08" izz="0.32381"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/base_link.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1"/>
      </material>
    </visual>
  </link>

  <joint name="base_link_jt" type="fixed">
    <origin xyz="0 0.0017871 0.13952" rpy="0 0 0"/>
    <parent link="basefoot_link"/>
    <child link="base_link"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       WHEELS
  ══════════════════════════════════════════ -->

  <link name="wheel_back_right">
    <inertial>
      <origin xyz="-1.7854E-08 -1.0601E-08 -0.032453" rpy="0 0 0"/>
      <mass value="3.75"/>
      <inertia ixx="0.0036328" ixy="2.2843E-10" ixz="-1.3812E-09"
               iyy="0.0036328" iyz="-1.1956E-09" izz="0.0065547"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/wheel_back_right.STL"/>
      </geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
    </collision>
  </link>
  <joint name="wheel_back_right_jt" type="continuous">
    <origin xyz="-0.29179 -0.2607 -0.039516" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_back_right"/>
    <axis xyz="0 0 -1"/>
    <limit effort="18" velocity="21.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="wheel_back_left">
    <inertial>
      <origin xyz="-1.7189E-10 2.0763E-08 0.032453" rpy="0 0 0"/>
      <mass value="3.75"/>
      <inertia ixx="0.0036328" ixy="-2.3363E-10" ixz="-3.0799E-10"
               iyy="0.0036328" iyz="-1.8007E-09" izz="0.0065547"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/wheel_back_left.STL"/>
      </geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
    </collision>
  </link>
  <joint name="wheel_back_left_jt" type="continuous">
    <origin xyz="-0.29179 0.2607 -0.039516" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_back_left"/>
    <axis xyz="0 0 -1"/>
    <limit effort="18" velocity="21.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="wheel_front_left">
    <inertial>
      <origin xyz="1.7854E-08 -1.0601E-08 0.032453" rpy="0 0 0"/>
      <mass value="3.75"/>
      <inertia ixx="0.0036328" ixy="-2.2843E-10" ixz="-1.3812E-09"
               iyy="0.0036328" iyz="1.1956E-09" izz="0.0065547"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/wheel_front_left.STL"/>
      </geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
    </collision>
  </link>
  <joint name="wheel_front_left_jt" type="continuous">
    <origin xyz="0.29179 0.2607 -0.039516" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <axis xyz="0 0 -1"/>
    <limit effort="18" velocity="21.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <link name="wheel_front_right">
    <inertial>
      <origin xyz="1.7189E-10 2.0763E-08 -0.032453" rpy="0 0 0"/>
      <mass value="3.75"/>
      <inertia ixx="0.0036328" ixy="2.3363E-10" ixz="-3.0799E-10"
               iyy="0.0036328" iyz="1.8007E-09" izz="0.0065547"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/wheel_front_right.STL"/>
      </geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder length="0.05" radius="0.1"/></geometry>
    </collision>
  </link>
  <joint name="wheel_front_right_jt" type="continuous">
    <origin xyz="0.29179 -0.2607 -0.039516" rpy="1.5708 0 0"/>
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <axis xyz="0 0 -1"/>
    <limit effort="18" velocity="21.5"/>
    <dynamics damping="0.05" friction="0.05"/>
  </joint>

  <!-- ══════════════════════════════════════════
       LIDAR LINK
  ══════════════════════════════════════════ -->
  <link name="lidar">
    <inertial>
      <origin xyz="-0.00010213 3.2869E-06 -0.036403" rpy="0 0 0"/>
      <mass value="0.60561"/>
      <inertia ixx="0.00066704" ixy="-1.7526E-11" ixz="-1.8129E-06"
               iyy="0.00067092" iyz="6.6764E-08" izz="0.00080407"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/lidar.STL"/>
      </geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/lidar.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_jt" type="fixed">
    <origin xyz="0.1976 0.0041424 0.4005" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       IMU
  ══════════════════════════════════════════ -->
  <link name="imu">
    <inertial>
      <origin xyz="0.0012583 9.2935E-06 -0.0061404" rpy="0 0 0"/>
      <mass value="0.0040208"/>
      <inertia ixx="3.2279E-07" ixy="1.0925E-10" ixz="5.0046E-09"
               iyy="3.7643E-07" iyz="5.7411E-11" izz="6.7382E-07"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/imu.STL"/>
      </geometry>
      <material name=""><color rgba="0.75294 0.75294 0.75294 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://simulation/meshes/visual/imu.STL"/>
      </geometry>
    </collision>
  </link>
  <joint name="imu_jt" type="fixed">
    <origin xyz="0.186696441224005 0.00158367124236836 0.2805" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!-- ══════════════════════════════════════════
       CAMERA
  ══════════════════════════════════════════ -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.17 0.04 0.03"/></geometry>
      <material name="camera_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.17 0.04 0.03"/></geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="0.15 0.0 0.6" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Camera optical frame -->
  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
  </joint>

  <!-- ══════════════════════════════════════════
       GAZEBO PLUGINS
  ══════════════════════════════════════════ -->

  <!-- ── 2D LaserScan → /scan ──────────────────────────────── -->
  <gazebo reference="lidar">
    <sensor type="ray" name="lidar_2d_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>8.0</max>
          <resolution>0.015</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar_2d" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── 3D PointCloud2 → /velodyne_points ─────────────────── -->
  <gazebo reference="lidar">
    <sensor type="ray" name="lidar_3d_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle> 3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26180</min_angle>
            <max_angle> 0.26180</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.10</min>
          <max>100.0</max>
          <resolution>0.001</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.008</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_vlp16" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/velodyne_points</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── Skid-steer drive ────────────────────────────────────── -->
  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>wheel_front_left_jt</left_joint>
      <right_joint>wheel_front_right_jt</right_joint>
      <left_joint>wheel_back_left_jt</left_joint>
      <right_joint>wheel_back_right_jt</right_joint>
      <wheel_separation>0.583</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>basefoot_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ── Joint state publisher ───────────────────────────────── -->
  <gazebo>
    <plugin name="gazebo_ros_joint_state_publisher"
            filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>joint_states:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>wheel_back_left_jt</joint_name>
      <joint_name>wheel_back_right_jt</joint_name>
      <joint_name>wheel_front_left_jt</joint_name>
      <joint_name>wheel_front_right_jt</joint_name>
    </plugin>
  </gazebo>

  <!-- ── IMU ─────────────────────────────────────────────────── -->
  <gazebo reference="imu">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev></noise></z>
        </linear_acceleration>
      </imu>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/imu/data</remapping>
        </ros>
        <frame_name>imu</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── RGB Camera → /camera/image_raw ─────────────────────── -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="rgb_camera">
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <camera name="rgb_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>15.0</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=camera/image_raw</remapping>
          <remapping>camera_info:=camera/camera_info</remapping>
        </ros>
        <camera_name>rgb_camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
        <hack_baseline>0.0</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── Depth Camera → /camera/depth/image_raw ─────────────── -->
  <!-- Dùng libgazebo_ros_openni_kinect.so — plugin depth ổn định
       nhất trong Gazebo Classic (không gây segfault như
       libgazebo_ros_depth_camera.so hoặc libgazebo_ros_camera.so
       với sensor type=depth) -->
  <gazebo reference="camera_link">
    <sensor type="depth" name="depth_camera">
      <update_rate>30</update_rate>
      <visualize>false</visualize>
      <camera name="depth_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <plugin name="depth_camera_controller"
              filename="libgazebo_ros_openni_kinect.so">
        <ros>
          <namespace>/</namespace>
          <remapping>image_raw:=camera/color/image_raw</remapping>
          <remapping>image_depth:=camera/depth/image_raw</remapping>
          <remapping>camera_info:=camera/color/camera_info</remapping>
          <remapping>camera_info_depth:=camera/depth/camera_info</remapping>
          <remapping>points:=camera/depth/points</remapping>
        </ros>
        <camera_name>depth_camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ── Wheel friction ──────────────────────────────────────── -->
  <gazebo reference="wheel_back_right">
    <mu1>0.9</mu1><mu2>0.2</mu2><kp>1000000.0</kp><kd>1.0</kd><fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="wheel_back_left">
    <mu1>0.9</mu1><mu2>0.2</mu2><kp>1000000.0</kp><kd>1.0</kd><fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="wheel_front_left">
    <mu1>0.9</mu1><mu2>0.2</mu2><kp>1000000.0</kp><kd>1.0</kd><fdir1>1 0 0</fdir1>
  </gazebo>
  <gazebo reference="wheel_front_right">
    <mu1>0.9</mu1><mu2>0.2</mu2><kp>1000000.0</kp><kd>1.0</kd><fdir1>1 0 0</fdir1>
  </gazebo>

</robot>
